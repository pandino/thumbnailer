[Unit]
Description=Thumbnailer preference model: embed new grids, retrain, upload scores
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Adjust: venv created by install.sh, thumbnailer reachable on the LAN
ExecStart=%h/.local/share/thumbnailer-taste/venv/bin/python %h/.local/share/thumbnailer-taste/taste.py --server http://192.168.1.35:8080 --max-minutes 20
# Stay out of the way of interactive use
Nice=15
IOSchedulingClass=idle
CPUWeight=20
TimeoutStopSec=60
